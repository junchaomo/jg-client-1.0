{
  "id": "as-python-sample",
  "name": "AS Python 示例",
  "version": "1.0.0",
  "runtime": "python",
  "entry": "server.py",
  "appDir": "app",
  "health": { "path": "/health", "timeoutMs": 15000, "intervalMs": 250 },
  "embed": { "method": "browser" },
  "permissions": { "network": ["127.0.0.1"], "filesystem": ["AS_DATA_ROOT"] },
  "capabilities": {
    "tools": [
      {
        "name": "python.get_state",
        "description": "读取当前账号的 Python 应用打开次数、数据目录和进程信息",
        "method": "GET",
        "path": "/api/tools/state",
        "sideEffect": false,
        "inputSchema": { "type": "object", "properties": {} }
      }
    ]
  },
  "description": "AS Python runtime 最小验证应用：标准库 HTTP、动态端口、健康检查、账号级数据目录。"
}
