{
  "id": "as-sample",
  "name": "AS 示例应用",
  "version": "1.0.0",
  "runtime": "node",
  "entry": "server.mjs",
  "appDir": "app",
  "health": {
    "path": "/health",
    "timeoutMs": 15000,
    "intervalMs": 250
  },
  "embed": {
    "method": "browser"
  },
  "permissions": {
    "network": ["127.0.0.1"],
    "filesystem": ["AS_DATA_ROOT"]
  },
  "capabilities": {
    "tools": [
      {
        "name": "sample.get_state",
        "description": "读取当前账号的应用打开次数、数据目录和进程信息",
        "method": "GET",
        "path": "/api/tools/state",
        "sideEffect": false,
        "inputSchema": { "type": "object", "properties": {} }
      },
      {
        "name": "sample.echo",
        "description": "回显调用参数，用于验证 POST 能力代理",
        "method": "POST",
        "path": "/api/tools/echo",
        "sideEffect": false,
        "inputSchema": {
          "type": "object",
          "properties": { "message": { "type": "string", "description": "任意测试文本" } }
        }
      },
      {
        "name": "sample.append_note",
        "description": "向当前账号追加一条备注（写操作，需审批）",
        "method": "POST",
        "path": "/api/tools/note",
        "sideEffect": true,
        "inputSchema": {
          "type": "object",
          "properties": { "note": { "type": "string", "description": "备注内容" } },
          "required": ["note"]
        }
      }
    ]
  },
  "description": "AS Runtime 最小验证应用：独立进程、动态端口、健康检查、账号级数据目录。"
}
