# 本地私密配置示例。复制为 .env.local 后填写，真实值不要提交。
# 国务院政策文件库垂直检索所需的应用密钥。
JG_GOV_SEARCH_APP_SECRET=

# OnlyOffice 在线 Office 编辑。可不填，默认读取 data/onlyoffice.json。
# JG_ONLYOFFICE_ENABLED=1
# JG_ONLYOFFICE_URL=http://127.0.0.1:8082
# JG_ONLYOFFICE_PUBLIC_URL=http://127.0.0.1:8082
# JG_ONLYOFFICE_DOCUMENT_HOST_URL=http://host.docker.internal:54270
# JG_ONLYOFFICE_SECRET=
# JG_ONLYOFFICE_HEADER=AuthorizationJwt
# 设为 0 可关闭 Electron 启动时的 OnlyOffice 自动拉起。
# JG_ONLYOFFICE_AUTOSTART=1
